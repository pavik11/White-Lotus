DerivedData/
build/
.build/
*.app/
*.ipa
*.dSYM/
*.dSYM.zip
*.xcarchive/
*.xcresult/

# Local signing identities and provisioning material.
*.p12
*.p8
*.key
*.pem
*.mobileprovision
*.provisionprofile

# Local chat data, if copied into the project for troubleshooting.
WellnessChats/
WellnessUITestChats/

# macOS metadata and local editor files.
.DS_Store
.AppleDouble
.LSOverride
*.swp
*.swo
*~
