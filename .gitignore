# Real credentials: keep only the blank example config in Git.
/Config/Secrets.local.xcconfig
**/Secrets.local.xcconfig
.env
.env.*
!.env.example
*.local.env

# Xcode user-specific settings, private schemes, and editor state.
**/xcuserdata/
*.xcuserstate
*.xccheckout
*.xcscmblueprint

